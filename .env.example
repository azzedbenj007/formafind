# Supabase — projet dédié à la GMAO (Postgres + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Clé service_role — SERVEUR UNIQUEMENT (jobs cron, opérations admin).
# Ne jamais préfixer par NEXT_PUBLIC_, ne jamais importer dans un fichier "use client".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic — chatbot IA (tool-use sur les données Supabase). SERVEUR UNIQUEMENT.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Secret partagé pour protéger les routes /api/cron/* (génération des interventions
# préventives, alertes de contrats). Générez une chaîne aléatoire longue.
CRON_SECRET=change-me-with-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000
